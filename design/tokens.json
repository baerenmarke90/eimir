  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Literata", "Georgia", "serif"] },
      "ui": { "$value": ["Instrument Sans", "Arial", "sans-serif"] },
      "system": { "$value": ["system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": ["Literata", "Georgia", "serif"],
        "fontSize": "48px",
        "fontWeight": 600,
        "letterSpacing": "-0.02em",
        "lineHeight": 1.08
      }
    },
    "heading1": {
      "$value": {
        "fontFamily": ["Instrument Sans", "Arial", "sans-serif"],
        "fontSize": "36px",
        "fontWeight": 700,
        "letterSpacing": "-0.015em",
        "lineHeight": 1.15
      }
    },
    "heading2": {
      "$value": {
