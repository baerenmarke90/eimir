# Copy to .env and fill in local values. .env is not committed.
#
# This template is prepared for LOCAL SOURCE TESTING:
#
#   cp .env.example .env
#   # replace POSTGRES_PASSWORD
#   python3 scripts/build_self_hosted_source.py --env-file .env
#   docker compose --profile self-hosted --env-file .env up -d --wait --wait-timeout 300
#
# Web and API then bind to 127.0.0.1 only, outgoing mail is written to the local
# delivery log, and neither SMTP access nor a public HTTPS domain is required.
#
# Important: compose.yaml remains the only tracked Compose manifest. The helper
# builds local backend/Web images and this env points the canonical manifest at
# those local tags. Released Self-Hosted Production never builds source; see
# deploy/self-hosted-release.env.example and docs/SELF-HOSTING.md.
COMPOSE_PROFILES=self-hosted
EIMIR_SELF_HOSTED_BACKEND_IMAGE=eimir-backend:source-local
EIMIR_SELF_HOSTED_WEB_IMAGE=eimir-web:source-local
EIMIR_SELF_HOSTED_PULL_POLICY=never
EIMIR_BUILD_REVISION=unverified-local-checkout

# Persistent Development/Staging and Production promotion follow the binding
# workflow in docs/DEVELOPMENT-AND-RELEASE-ENVIRONMENTS.md. Start persistent
# Development from deploy/persistent-development.env.example.

# development = local source-test mode (default)
# demo        = isolated public Demo with Production hardening
# production  = real released operation; source-build helpers refuse this mode
EIMIR_ENVIRONMENT=development

# Demo behavior is off by default. The public Demo instance sets
# EIMIR_ENVIRONMENT=demo and EIMIR_DEMO_MODE=true. Demo initialization is an explicit
# Demo-only lifecycle step and is not part of the normal Self-Hosted startup path.
EIMIR_DEMO_MODE=false

# Optional automatic reset of the canonical Demo Space. The worker uses the
# existing persistent job queue; no cron container is required.
EIMIR_DEMO_MODE_RESET_TIMER=false
# Compact interval: m = minutes, h = hours, d = days. Allowed range: 5m to 7d.
EIMIR_DEMO_MODE_RESET_INTERVAL=6h

# Web build only: if set, the login page shows the Demo entry point and links to
# this separate Demo instance, for example https://demo.eimir.example.
EIMIR_DEMO_PUBLIC_URL=

POSTGRES_USER=eimir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eimir

# API host port. 8000 is only the default and must be free on the Docker host.
# Select another free port before startup if necessary, for example API_PORT=8010.
# The container itself continues to listen on port 8000.
API_PORT=8000

# Host port of the Web runtime.
WEB_PORT=8080

# Docker-host address on which API_PORT and WEB_PORT are published. Loopback is
# the safe default. If the TLS reverse proxy runs on another private host, bind
# deliberately to the Docker host's private address, e.g. EIMIR_BIND_IP=192.168.10.20.
# Avoid 0.0.0.0 unless broad exposure is explicitly required and protected.
EIMIR_BIND_IP=127.0.0.1

# Before the very first registration, generate this locally and put it only in
# your own .env. Use at least 32 characters and remove it after bootstrap.
# EIMIR_BOOTSTRAP_TOKEN=

# Instance-wide ServerAdmin identities. Use a JSON list of Account email
# addresses. Authorization matches only verified email rows and never Space
# membership. An empty list fails closed: no account receives ServerAdmin.
EIMIR_SERVER_ADMIN_EMAILS=[]

# --- Production and public Demo requirements ---
#
# Cursor signing key. Generate a random stable value per Production/Demo
# instance, at least 32 characters. Do not reuse a database password, bootstrap
# token or another secret. Development may use the local fallback.
#
#   openssl rand -base64 48
#
# EIMIR_CURSOR_SIGNING_KEY=

# Restore-safe Account-deletion authority. Do NOT generate this UUID separately.
# For an installation that has never had a deletion authority, leave this blank
# and create the UUID plus forward journal together once:
#
#   docker compose --profile self-hosted --env-file .env run --rm --no-deps api \
#     python -m eimir.identity.deletion_bootstrap \
#     --confirm-new-installation
#
# The command prints EIMIR_ACCOUNT_DELETION_INSTANCE_ID=<stable-instance-uuid>.
# Store exactly that value here and in the protected operator configuration
# backup. Production refuses normal API traffic until the configured UUID matches
# the separately protected deletion_journal_data volume.
#
# If this installation already had an authority (UUID or journal), a missing or
# damaged journal is a recovery case. Never clear the UUID or bootstrap a
# replacement authority; restore the newest protected journal according to
# docs/ACCOUNT-DELETION-SELF-HOSTED.md.
EIMIR_ACCOUNT_DELETION_INSTANCE_ID=

# JSON list of host names accepted by the API. Add the concrete public name used
# by the HTTPS reverse proxy; never use "*".
EIMIR_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Smallest IP/CIDR range of the reverse proxy whose X-Forwarded-* headers Uvicorn
# may trust. Without a proxy, keep the safe loopback default.
TRUSTED_PROXY_IPS=127.0.0.1

# Public origin of this instance. Authentication/recovery links use this value.
# Local source testing may use HTTP localhost. Production/Demo require https://.
EIMIR_PUBLIC_BASE_URL=http://localhost:8080

# Media uses the private local Compose volume by default. For a private
# S3-compatible bucket, switch to "s3" and set the provider values below.
EIMIR_MEDIA_STORE=local
# EIMIR_S3_ENDPOINT=https://s3.example.com
# EIMIR_S3_REGION=eu-central-1
# EIMIR_S3_BUCKET=eimir-private
# EIMIR_S3_ACCESS_KEY_ID=
# EIMIR_S3_SECRET_ACCESS_KEY=
# EIMIR_S3_SESSION_TOKEN=
# Compose adds the exact EIMIR_S3_ENDPOINT origin to the Web CSP connect-src list.
# No second CSP or browser configuration is required for normal Self-Hosted use.

# Outgoing mail modes:
#
#   log   message is delivered to the local log channel. LOCAL TESTING ONLY;
#         Production/Demo reject it because one-time links would be exposed.
#   smtp  real delivery through the configured SMTP server.
#   none  this instance sends no email. Magic Link, password recovery and email
#         verification then return 503; password, Passkey and OIDC remain usable.
#         This is allowed in Production/Demo and is recommended for public Demo.
EIMIR_MAIL_TRANSPORT=log
EIMIR_MAIL_FROM=no-reply@localhost
# EIMIR_SMTP_HOST=
# EIMIR_SMTP_PORT=587
# EIMIR_SMTP_USERNAME=
# EIMIR_SMTP_PASSWORD=
# EIMIR_SMTP_STARTTLS=true

# Optional UnifiedPush sender. Leave all three unset to keep Push unavailable.
# The VAPID private key is a stable, base64url-encoded 32-byte P-256 scalar.
# Only listed HTTPS push-server origins can receive requests.
# EIMIR_PUSH_VAPID_PRIVATE_KEY=
# EIMIR_PUSH_VAPID_SUBJECT=mailto:push@example.org
# EIMIR_PUSH_WEBPUSH_ALLOWED_ORIGINS=["https://push.example.org"]

# OIDC connections as a JSON list. Each connection has an arbitrary id used in
# login endpoint paths. issuer must use HTTPS. Pocket ID is an ordinary provider.
# Optional android_redirect_uri is an operator-registered native callback used
# only for Android recent-authentication step-up.
# EIMIR_OIDC_CONNECTIONS=[{"id":"pocket","issuer":"https://id.example","client_id":"eimir","client_secret":"...","redirect_uri":"https://app.example/oidc","android_redirect_uri":"de.sidebyside.app://recent-authentication/oidc"}]

# WebAuthn/Passkeys. Without explicit values the Relying Party derives from
# EIMIR_PUBLIC_BASE_URL, so a passkey for app.example is not valid on another domain.
# EIMIR_WEBAUTHN_RP_ID=app.example
# EIMIR_WEBAUTHN_RP_NAME=eimir.
# EIMIR_WEBAUTHN_ORIGINS=["https://app.example"]

# --- Arcane / remote source workspace only ---
#
# Arcane Development may intentionally build from Git. Set both build contexts
# and EIMIR_BUILD_REVISION to the same repository ref, then invoke
# scripts/build_self_hosted_source.py. Never put credentials/tokens into the URL;
# private repositories use BuildKit/Arcane Git authentication.
#
# Example for Development on main:
# EIMIR_BACKEND_BUILD_CONTEXT=https://github.com/baerenmarke90/eimir.git#main:backend
# EIMIR_WEB_BUILD_CONTEXT=https://github.com/baerenmarke90/eimir.git#main:web
# EIMIR_BUILD_REVISION=main
#
# Released Production never uses these source-build values. It pulls the OCI
# images published by #519/#827 through the released Production launcher.

# Persistent Development and Production projects must use different
# COMPOSE_PROJECT_NAME values so their named volumes and networks cannot collide.
# The local checkout intentionally leaves this unset so Compose derives the name
# from the checkout directory.
