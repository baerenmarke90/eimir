# Released Self-Hosted deployment template.
#
# Copy to .env in the extracted Self-Hosted operator bundle. This file does NOT
# set COMPOSE_FILE: repository-root compose.yaml is the single released runtime
# topology and consumes prebuilt OCI images instead of building application source.
#
# Released Production is operated either
#   - from Arcane (docs/ARCANE.md): configure -> bootstrap once -> deploy / update;
#     compose.yaml carries the release-guard, so plain Deploy/Redeploy is gated; or
#   - through: python3 scripts/self_hosted_release.py --env-file .env <operation>
# Do not add a second Compose manifest or remove the release-guard service.

# New installation only: set COMPOSE_PROFILES=bootstrap (nothing else) for the single
# bootstrap deploy, then return to self-hosted.
COMPOSE_PROFILES=self-hosted
COMPOSE_PROJECT_NAME=eimir-self-hosted
EIMIR_ENVIRONMENT=production
EIMIR_DEPLOYMENT=self_hosted

# Product version published by the protected release workflow. The mandatory
# Production launcher verifies that the actual backend/Web image references carry
# exactly this version before pull/bootstrap/start.
EIMIR_RELEASE_VERSION=0.1.0

# Both digest-qualified references from the same GitHub Release's
# self-hosted-image-identity.json are REQUIRED when Arcane/Compose deploys directly
# (the release-guard refuses tag-only images); the launcher fills them in itself. The
# v0.1.0 tag component must still match EIMIR_RELEASE_VERSION; changing both
# overrides to another version is intentionally rejected.
# EIMIR_SELF_HOSTED_BACKEND_IMAGE=ghcr.io/baerenmarke90/eimir-backend:v0.1.0@sha256:<digest>
# EIMIR_SELF_HOSTED_WEB_IMAGE=ghcr.io/baerenmarke90/eimir-web:v0.1.0@sha256:<digest>

POSTGRES_USER=eimir
POSTGRES_PASSWORD=replace-with-production-database-password
POSTGRES_DB=eimir

API_PORT=8000
WEB_PORT=8080
EIMIR_BIND_IP=127.0.0.1

EIMIR_PUBLIC_BASE_URL=https://replace-with-public-origin.example
EIMIR_ALLOWED_HOSTS=["replace-with-public-origin.example"]
TRUSTED_PROXY_IPS=127.0.0.1
EIMIR_CURSOR_SIGNING_KEY=replace-with-production-only-signing-key-at-least-32-chars

# Leave blank only during a genuinely new installation until the one-time bootstrap
# (Arcane: COMPOSE_PROFILES=bootstrap; launcher: bootstrap-deletion-authority) creates
# UUID + forward journal together. Established installations must restore their
# existing authority.
EIMIR_ACCOUNT_DELETION_INSTANCE_ID=
EIMIR_SERVER_ADMIN_EMAILS=[]
EIMIR_BOOTSTRAP_TOKEN=

EIMIR_DEMO_MODE=false
EIMIR_DEMO_MODE_RESET_TIMER=false
EIMIR_DEMO_MODE_RESET_INTERVAL=6h
EIMIR_DEMO_PUBLIC_URL=

EIMIR_MEDIA_STORE=local
EIMIR_S3_ENDPOINT=
EIMIR_S3_REGION=us-east-1
EIMIR_S3_BUCKET=
EIMIR_S3_ACCESS_KEY_ID=
EIMIR_S3_SECRET_ACCESS_KEY=
EIMIR_S3_SESSION_TOKEN=

# Production may use smtp or none; log is rejected by the application.
EIMIR_MAIL_TRANSPORT=none
EIMIR_MAIL_FROM=no-reply@replace-with-public-origin.example
EIMIR_SMTP_HOST=
EIMIR_SMTP_PORT=587
EIMIR_SMTP_USERNAME=
EIMIR_SMTP_PASSWORD=
EIMIR_SMTP_STARTTLS=true

EIMIR_OIDC_CONNECTIONS=[]
EIMIR_WEBAUTHN_RP_ID=
EIMIR_WEBAUTHN_RP_NAME=eimir.
EIMIR_WEBAUTHN_ORIGINS=[]
