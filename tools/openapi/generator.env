# Pin the generator by version *and* digest.
#
# A version alone is insufficient: a tag can be reassigned, and an unnoticed
# generator change would silently produce different client code. The digest
# makes the run reproducible, while the version makes the selected release
# readable.
#
# To update: enter the new tag, run `docker pull`, record the reported digest
# here, run `generate.sh`, and explain the resulting diff in the pull request.
OPENAPI_GENERATOR_VERSION=v7.24.0
OPENAPI_GENERATOR_DIGEST=sha256:5bf3dc75f764c584da8e3344c51b2f3f1e74703461d46a035b5ac1d31515cc88
