{
  "name": "eimir-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens:check && npm run build:bundle",
    "build:bundle": "tsc -b && vite build",
    "test": "npm run tokens:check && vitest run",
    "tokens:generate": "node scripts/generate-product-roles.mjs",
    "tokens:check": "node scripts/generate-product-roles.mjs --check",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format . --write"
  },
  "dependencies": {
    "@tanstack/react-query": "5.85.5",
    "i18next": "26.4.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "17.0.11",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "jsdom": "^30.0.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
