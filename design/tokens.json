    "control": {
      "$type": "dimension",
      "compact": { "$value": "36px" },
      "standard": { "$value": "44px" },
      "comfortable": { "$value": "48px" }
    }
  },
  "layout": {
    "contentMax": { "$type": "dimension", "$value": "1200px" },
    "readingMax": { "$type": "dimension", "$value": "720px" },
    "mobileGutter": { "$type": "dimension", "$value": "20px" },
    "mobileGutterNarrow": { "$type": "dimension", "$value": "{spacing.4}" },
    "webGutterMin": { "$type": "dimension", "$value": "24px" },
    "webGutterMax": { "$type": "dimension", "$value": "64px" },
    "navigationRail": { "$type": "dimension", "$value": "80px" },
    "sidebar": { "$type": "dimension", "$value": "256px" },
    "detailPaneMin": { "$type": "dimension", "$value": "320px" },
    "detailPaneMax": { "$type": "dimension", "$value": "480px" },
    "breakpoint": {
      "compactComfortableMin": { "$type": "dimension", "$value": "390px" },
      "compactMax": { "$type": "dimension", "$value": "599px" },
      "mediumMin": { "$type": "dimension", "$value": "600px" },
      "mediumMax": { "$type": "dimension", "$value": "839px" },
      "expandedMin": { "$type": "dimension", "$value": "840px" }
    }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "strong": { "$value": "2px" },
    "focus": { "$value": "3px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast": { "$value": "120ms" },
      "standard": { "$value": "180ms" },
      "emphasized": { "$value": "280ms" },
      "maximum": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0.2, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "#211A2B14",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "10px",
        "spread": "0px"
      }
    },
    "overlay": {
      "$value": {
        "color": "#211A2B24",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "32px",
        "spread": "0px"
      }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.56 },
    "subtle": { "$value": 0.72 },
    "opaque": { "$value": 1 }
  },
  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 100 },
    "overlay": { "$value": 400 },
    "modal": { "$value": 500 },
    "toast": { "$value": 600 }
