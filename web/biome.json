{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "root": "..",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!src/api/generated",
      "!vite.config.js",
      "!vite.config.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["public/webview-unsupported.js"],
      "javascript": {
        "formatter": {
          "trailingCommas": "es5"
        }
      },
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off",
            "useOptionalChain": "off"
          },
          "suspicious": {
            "noPrototypeBuiltins": "off"
          }
        }
      }
    }
  ]
}
