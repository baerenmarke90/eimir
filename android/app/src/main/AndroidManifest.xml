<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/app_icon_original"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/app_icon_original"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".LauncherActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="de.eimir.app"
                    android:host="recent-authentication"
                    android:path="/oidc" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="de.eimir.app" android:host="notifications" />
            </intent-filter>

        </activity>

        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_messaging_installation_id_enabled" android:value="true" />

        <service android:name=".EimirFirebaseMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".EimirPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".LauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/app_icon_original"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.eimir.app.icons.pearl"
            android:targetActivity=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_pearl"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.eimir.app.icons.dark"
            android:targetActivity=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_dark"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.eimir.app.icons.monochrome"
            android:targetActivity=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_monochrome"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.eimir.app.icons.sunset"
            android:targetActivity=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_sunset"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.eimir.app.icons.sage"
            android:targetActivity=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_sage"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.eimir.app.icons.daylight"
            android:targetActivity=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_daylight"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.eimir.app.icons.lavender"
            android:targetActivity=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_lavender"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.eimir.app.icons.sand"
            android:targetActivity=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_sand"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.eimir.app.icons.midnight"
            android:targetActivity=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_midnight"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.eimir.app.icons.minimal"
            android:targetActivity=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_icon_minimal"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
