{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eimir. Date Ideas — Catalog v1",
  "description": "Editorial handoff for the eimir. Pro Date Ideas Discovery. This versioned data file is not an API request schema or an entitlement source.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "description": "Content revision within schema v1. Copy edits do not change stable idea IDs."
    },
    "defaultLocale": {
      "const": "de",
      "description": "Use the whole default locale entry if a locale is not available; do not combine fields in two languages."
    },
    "locales": {
      "const": [
        "de",
        "en"
      ],
      "description": "Every idea and label has complete copy for the v1 locales."
    },
    "currency": {
      "const": "EUR"
    },
    "placeTypeLabels": {
      "type": "object",
      "properties": {
        "home": {
          "$ref": "#/$defs/localizedLabel"
        },
        "out": {
          "$ref": "#/$defs/localizedLabel"
        }
      },
      "required": [
        "home",
        "out"
      ],
      "additionalProperties": false
    },
    "categoryLabels": {
      "type": "object",
      "properties": {
        "food_drink": {
          "$ref": "#/$defs/localizedLabel"
        },
        "creative": {
          "$ref": "#/$defs/localizedLabel"
        },
        "play": {
          "$ref": "#/$defs/localizedLabel"
        },
        "nature": {
          "$ref": "#/$defs/localizedLabel"
        },
        "culture": {
          "$ref": "#/$defs/localizedLabel"
        },
        "movement": {
          "$ref": "#/$defs/localizedLabel"
        },
        "relaxation": {
          "$ref": "#/$defs/localizedLabel"
        },
        "connection": {
          "$ref": "#/$defs/localizedLabel"
        },
        "memories": {
          "$ref": "#/$defs/localizedLabel"
        },
        "discovery": {
          "$ref": "#/$defs/localizedLabel"
        }
      },
      "required": [
        "food_drink",
        "creative",
        "play",
        "nature",
        "culture",
        "movement",
        "relaxation",
        "connection",
        "memories",
        "discovery"
      ],
      "additionalProperties": false
    },
    "ideas": {
      "type": "array",
      "minItems": 200,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/idea"
      },
      "description": "Exactly 200 ideas in v1. Imports must also check ID uniqueness across items."
    },
    "retiredIdeaIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^eimir-date-(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
      },
      "description": "Permanent record of retired idea IDs. Include every previously retired ID and every ID removed by this revision. Active ideas must not reuse these IDs."
    }
  },
  "required": [
    "schemaVersion",
    "catalogVersion",
    "defaultLocale",
    "locales",
    "currency",
    "placeTypeLabels",
    "categoryLabels",
    "ideas"
  ],
  "additionalProperties": false,
  "$defs": {
    "localizedLabel": {
      "type": "object",
      "properties": {
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "\\S"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "\\S"
        }
      },
      "required": [
        "de",
        "en"
      ],
      "additionalProperties": false
    },
    "idea": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^eimir-date-(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$",
          "description": "Persistent editorial identifier. Keep it stable across locales, copy edits and reordering. Never use it as a Wish or Plan ID or assign it to a different idea."
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "description": "Editorial time budget from a nearby shared starting point, including the activity, any local leg described, setup and cleanup. A separate trip to the starting point is not estimated."
        },
        "budgetEurForTwo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Editorial spending cap in whole EUR for two, including applicable admission, rentals, supplies and any transport described in the idea. Zero means no new spending if the stated prerequisites are met. Check local prices; excludes items already owned and any separate trip to the starting point."
        },
        "placeType": {
          "type": "string",
          "enum": [
            "home",
            "out"
          ],
          "description": "Primary setting. 'Out' includes indoor venues away from home. The 'anywhere' filter selects both settings and is not a stored value."
        },
        "category": {
          "type": "string",
          "enum": [
            "food_drink",
            "creative",
            "play",
            "nature",
            "culture",
            "movement",
            "relaxation",
            "connection",
            "memories",
            "discovery"
          ],
          "description": "Single editorial category used for filtering. This is not an authored Wish or Plan tag."
        },
        "copy": {
          "type": "object",
          "properties": {
            "de": {
              "$ref": "#/$defs/ideaCopy"
            },
            "en": {
              "$ref": "#/$defs/ideaCopy"
            }
          },
          "required": [
            "de",
            "en"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "minutes",
        "budgetEurForTwo",
        "placeType",
        "category",
        "copy"
      ],
      "additionalProperties": false
    },
    "ideaCopy": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S",
          "description": "Action-oriented copy for the idea card, in plain text."
        },
        "wishTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70,
          "pattern": "\\S",
          "description": "Editable prefill for the existing Wish composer."
        },
        "planTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70,
          "pattern": "\\S",
          "description": "Editable prefill for the existing Plan composer, including when converted from a known Wish."
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 145,
            "pattern": "\\S"
          },
          "description": "On-hand materials, access, timing or conditions. An empty array means no special prerequisites."
        }
      },
      "required": [
        "title",
        "description",
        "wishTitle",
        "planTitle",
        "prerequisites"
      ],
      "additionalProperties": false
    }
  }
}
