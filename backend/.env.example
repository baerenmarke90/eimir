# Entwicklung. Kopieren nach .env.
EIMIR_ENVIRONMENT=development
EIMIR_DEPLOYMENT=self_hosted
EIMIR_DATABASE_URL=postgresql+psycopg://eimir:eimir@localhost:5432/eimir
EIMIR_MEDIA_STORE=local
EIMIR_MEDIA_ROOT=./data/media

# Alternativ: privater S3-kompatibler Bucket.
# EIMIR_MEDIA_STORE=s3
# EIMIR_S3_ENDPOINT=https://s3.example.com
# EIMIR_S3_REGION=eu-central-1
# EIMIR_S3_BUCKET=eimir-private
# EIMIR_S3_ACCESS_KEY_ID=
# EIMIR_S3_SECRET_ACCESS_KEY=
# EIMIR_S3_SESSION_TOKEN=

# Optional UnifiedPush sender: configure all three together.
# EIMIR_PUSH_VAPID_PRIVATE_KEY=
# EIMIR_PUSH_VAPID_SUBJECT=mailto:push@example.org
# EIMIR_PUSH_WEBPUSH_ALLOWED_ORIGINS=["https://push.example.org"]

# Nur fuer Integrationstests. Ohne diese Variable werden sie uebersprungen.
EIMIR_TEST_DATABASE_URL=postgresql+psycopg://eimir:eimir@localhost:5432/eimir_test
