# Persistent Development / Staging template for eimir.
#
# Copy these values into a dedicated Arcane project/environment. Do not use the
# Production or public Demo project, database, volumes, media bucket, or secrets.
# The authoritative workflow is docs/DEVELOPMENT-AND-RELEASE-ENVIRONMENTS.md.
#
# Persistent Development intentionally builds source images first, then runs the
# same canonical compose.yaml used by released Self-Hosted. Released Production
# points that manifest at published OCI images instead of the local tags below.
COMPOSE_PROJECT_NAME=eimir-development
COMPOSE_PROFILES=self-hosted
EIMIR_SELF_HOSTED_BACKEND_IMAGE=eimir-backend:source-development
EIMIR_SELF_HOSTED_WEB_IMAGE=eimir-web:source-development
EIMIR_SELF_HOSTED_PULL_POLICY=never

# Persistent Development follows main for ordinary integration. Before a release,
# pin all three values below to the exact same candidate commit SHA and rebuild
# the complete source images with scripts/build_self_hosted_source.py. Remote Git
# build credentials belong to Arcane/BuildKit, never in these URLs.
EIMIR_BACKEND_BUILD_CONTEXT=https://github.com/baerenmarke90/eimir.git#main:backend
EIMIR_WEB_BUILD_CONTEXT=https://github.com/baerenmarke90/eimir.git#main:web
EIMIR_BUILD_REVISION=main

EIMIR_ENVIRONMENT=development
EIMIR_DEMO_MODE=false
EIMIR_DEMO_MODE_RESET_TIMER=false
EIMIR_DEMO_MODE_RESET_INTERVAL=6h
EIMIR_DEMO_PUBLIC_URL=

# Development-only database identity. Replace the password with a strong value
# that is not used by Production or Demo.
POSTGRES_USER=eimir_dev
POSTGRES_PASSWORD=replace-with-development-only-secret
POSTGRES_DB=eimir_dev

# Loopback is the safe default. For Android/device testing, expose the instance
# only through a controlled private network/VPN or protected TLS reverse proxy.
EIMIR_BIND_IP=127.0.0.1
API_PORT=18000
WEB_PORT=18080
EIMIR_PUBLIC_BASE_URL=http://localhost:18080
EIMIR_ALLOWED_HOSTS=["localhost","127.0.0.1"]
TRUSTED_PROXY_IPS=127.0.0.1

# Use a stable Development-only signing key. Development may technically start
# without it, but a persistent environment should not silently change its cursor
# signing identity between deployments.
EIMIR_CURSOR_SIGNING_KEY=replace-with-development-only-signing-key-at-least-32-chars

# Self-service Account deletion uses a forward-only journal outside PostgreSQL.
# Do not generate the Development authority UUID separately. Leave this unset
# until this project is provisioned, then create UUID + journal together once:
#
#   docker compose --profile self-hosted --env-file .env run --rm --no-deps api \
#     python -m eimir.identity.deletion_bootstrap \
#     --confirm-new-installation
#
# Store the emitted EIMIR_ACCOUNT_DELETION_INSTANCE_ID here and keep it stable for
# this Development project. Never reuse the Production authority. If an authority
# already existed and its journal is missing, recover that journal instead of
# bootstrapping a replacement; see docs/ACCOUNT-DELETION-SELF-HOSTED.md.
EIMIR_ACCOUNT_DELETION_INSTANCE_ID=

# Initial bootstrap only. Remove after the first Development account exists.
EIMIR_BOOTSTRAP_TOKEN=replace-with-development-only-bootstrap-token-at-least-32-chars

# ServerAdmin is instance-wide and independent of Space membership. Replace the
# empty JSON list with verified account email addresses that may operate this
# Development installation, for example ["admin-dev@example.test"].
EIMIR_SERVER_ADMIN_EMAILS=[]

# Local media is simplest for a dedicated Arcane project because its named
# volume is isolated by COMPOSE_PROJECT_NAME. For S3, use a Development-only
# private bucket and credentials, never the Production bucket.
EIMIR_MEDIA_STORE=local
# EIMIR_S3_ENDPOINT=https://s3-dev.example
# EIMIR_S3_REGION=eu-central-1
# EIMIR_S3_BUCKET=eimir-development-private
# EIMIR_S3_ACCESS_KEY_ID=
# EIMIR_S3_SECRET_ACCESS_KEY=
# EIMIR_S3_SESSION_TOKEN=

# Persistent Development should not emit real one-time authentication links to
# shared logs by accident. `none` is the safest default; use a Development-only
# SMTP account when mail-flow acceptance is required.
EIMIR_MAIL_TRANSPORT=none
EIMIR_MAIL_FROM=no-reply@development.invalid
# EIMIR_SMTP_HOST=
# EIMIR_SMTP_PORT=587
# EIMIR_SMTP_USERNAME=
# EIMIR_SMTP_PASSWORD=
# EIMIR_SMTP_STARTTLS=true

# Configure separate Development callbacks/clients if these providers are used.
EIMIR_OIDC_CONNECTIONS=[]
EIMIR_WEBAUTHN_RP_ID=
EIMIR_WEBAUTHN_RP_NAME=eimir. Development
EIMIR_WEBAUTHN_ORIGINS=[]
