# Append the missing values to the EXISTING eimir-test Arcane environment.
# Keep its current POSTGRES_PASSWORD, EIMIR_SMTP_PASSWORD,
# EIMIR_CURSOR_SIGNING_KEY, EIMIR_ENCRYPTION_KEYS and EIMIR_MAIL_FROM unchanged.
# Never commit filled values or sync .env back to Git.
COMPOSE_PROJECT_NAME=eimir-test
EIMIR_PUBLIC_BASE_URL=https://demo.eimir.example
EIMIR_ALLOWED_HOSTS='["demo.eimir.example","localhost","127.0.0.1"]'
EIMIR_ENCRYPTION_ACTIVE_KEY_ID=
EIMIR_ACCOUNT_DELETION_INSTANCE_ID=
EIMIR_SERVER_ADMIN_EMAILS='[]'
EIMIR_WEBAUTHN_RP_ID=demo.eimir.example
EIMIR_WEBAUTHN_ORIGINS='["https://demo.eimir.example"]'
EIMIR_SMTP_HOST=mail.example
# Exact current NPM source IP on mailcow-proxy. Do not use * or the shared subnet.
TRUSTED_PROXY_IPS=

# Optional photo sources; append only if not already configured.
EIMIR_PHOTO_SOURCES_ENABLED=true
# Approved Google Photos Picker Web OAuth app; keep the secret operator-local.
EIMIR_GOOGLE_PHOTOS_CLIENT_ID=
EIMIR_GOOGLE_PHOTOS_CLIENT_SECRET=

# Optional local recap wording. The separate AI project uses the existing data network.
EIMIR_RECAP_AI_URL=http://eimir-test-recap-ai:11434
EIMIR_RECAP_AI_MODEL=qwen3:1.7b-q4_K_M
EIMIR_RECAP_AI_TIMEOUT_SECONDS=90
